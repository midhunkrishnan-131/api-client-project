# Copy this file to .env and fill in your actual values
# The client will fail loudly if API_KEY is missing

# For testing with JSONPlaceholder (no auth required, but client expects it)
API_KEY=test-key-not-needed-for-public-apis

# For testing with GitHub API (requires actual token)
# API_KEY=ghp_your_github_token_here

# For testing with other APIs
# API_KEY=your_actual_api_key_here
